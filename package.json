{
  "name": "aprint",
  "version": "0.1.0",
  "description": "Astro integration for academic, print-ready, Markdown-first documents with paged preview and PDF export.",
  "homepage": "https://github.com/atomiechen/aprint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/atomiechen/aprint.git"
  },
  "keywords": [
    "withastro",
    "astro-integration",
    "css",
    "tooling",
    "markdown",
    "print",
    "pdf",
    "paged-media",
    "pagedjs",
    "academic",
    "cv",
    "resume",
    "bibliography",
    "bibtex",
    "citation",
    "csl"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js",
      "default": "./dist/astro/index.js"
    },
    "./components/*.astro": "./src/astro/components/*.astro",
    "./layouts/*.astro": "./src/astro/layouts/*.astro",
    "./styles/*.css": "./src/astro/styles/*.css"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": false
    }
  },
  "bin": {
    "aprint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src/astro/components",
    "src/astro/layouts",
    "src/astro/styles",
    "src/astro/vendor/pagedjs-0.4.3.esm.min.js",
    "src/lib/csl",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { force: true, recursive: true })\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/fix-bin-mode.mjs",
    "dev": "astro dev",
    "check": "tsc -p tsconfig.playground.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "pdf": "tsx src/cli.ts pdf",
    "vendor:pagedjs": "npm run vendor:pagedjs:fetch && npm run vendor:pagedjs:minify",
    "vendor:pagedjs:fetch": "curl -L https://unpkg.com/pagedjs@0.4.3/dist/paged.esm.js -o src/astro/vendor/pagedjs-0.4.3.esm.js",
    "vendor:pagedjs:minify": "esbuild src/astro/vendor/pagedjs-0.4.3.esm.js --minify --format=esm --outfile=src/astro/vendor/pagedjs-0.4.3.esm.min.js",
    "prepack": "npm run build",
    "astro:build": "astro check && astro build",
    "astro:preview": "astro preview",
    "astro:check": "astro check"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.21",
    "commander": "^12.1.0",
    "remark-directive": "^4.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^22.10.2",
    "astro": "^5.7.10",
    "esbuild": "^0.27.7",
    "playwright": "^1.60.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
