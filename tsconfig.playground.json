{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "astro.config.mjs", "playground/**/*", "src/**/*.d.ts"],
  "exclude": [
    "site-dist",
    ".aprint",
    ".aprint-test",
    "public"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./playground/*"]
    }
  }
}
