---
interface Props {
  pageTitle?: string;
  faviconHref?: string | false;
}

const defaultFavicon = `data:image/svg+xml,${encodeURIComponent(`
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
    <rect width="64" height="64" rx="12" fill="#181716"/>
    <text x="32" y="45" fill="white" font-family="Georgia,serif" font-size="46" text-anchor="middle">a</text>
  </svg>
`)}`;
const { pageTitle, faviconHref = defaultFavicon } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {faviconHref && <link rel="icon" href={faviconHref} />}
    {pageTitle && <title>{pageTitle}</title>}
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  body {
    margin: 0;
  }
</style>
