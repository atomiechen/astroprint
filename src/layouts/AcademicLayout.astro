---
import type { ComponentProps } from "astro/types";
import AcademicDocument from "../components/AcademicDocument.astro";
import BaseLayout from "./BaseLayout.astro";
import PreviewShell from "../components/PreviewShell.astro";

type Props = ComponentProps<typeof PreviewShell> & {
  withRouteShell?: boolean;
  title?: string;
  secondaryTitle?: string;
  frontmatter?: Record<string, unknown>;
  entry?: {
    id?: string;
    data?: Record<string, unknown>;
  };
};

const { entry, frontmatter, withRouteShell = false } = Astro.props;
const title =
  Astro.props.title ??
  (typeof entry?.data?.title === "string" ? entry.data.title : undefined) ??
  (typeof frontmatter?.title === "string" ? frontmatter.title : undefined) ??
  entry?.id;
const secondaryTitle =
  Astro.props.secondaryTitle ??
  (typeof entry?.data?.secondaryTitle === "string" ? entry.data.secondaryTitle : undefined) ??
  (typeof frontmatter?.secondaryTitle === "string" ? frontmatter.secondaryTitle : undefined);
---

<BaseLayout pageTitle={title}>
  {
    withRouteShell ? (
      <PreviewShell {...Astro.props}>
        <AcademicDocument title={title} secondaryTitle={secondaryTitle}>
          <slot />
        </AcademicDocument>
      </PreviewShell>
    ) : (
      <AcademicDocument title={title} secondaryTitle={secondaryTitle}>
        <slot />
      </AcademicDocument>
    )
  }
</BaseLayout>
