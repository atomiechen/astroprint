---
import Document from "../components/Document.astro";

const { frontmatter } = Astro.props;
const title = frontmatter.title ?? frontmatter.name;
const secondaryTitle = frontmatter.secondaryTitle ?? frontmatter.nameZh;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <Document title={title} secondaryTitle={secondaryTitle}>
      <slot />
    </Document>
  </body>
</html>

<style is:global>
  html {
    background: white;
    color: #181716;
  }

  body {
    margin: 0;
  }
</style>
